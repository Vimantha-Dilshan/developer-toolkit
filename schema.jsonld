{
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebApplication",
            "@id": "https://vimantha-dilshan.github.io/developer-toolkit/#app",
            "name": "Orion",
            "alternateName": "Orion Developer Toolkit",
            "description": "Orion is a free, open-source, offline-capable Progressive Web App containing 28 developer tools that work entirely inside the browser with no backend required.",
            "url": "https://vimantha-dilshan.github.io/developer-toolkit/",
            "applicationCategory": "DeveloperApplication",
            "operatingSystem": "Any (browser-based)",
            "browserRequirements": "Requires a modern browser with JavaScript enabled",
            "softwareVersion": "1.0.0",
            "datePublished": "2026-08-04",
            "dateModified": "2026-08-04",
            "inLanguage": "en",
            "isAccessibleForFree": true,
            "license": "https://opensource.org/licenses/MIT",
            "author": {
                "@type": "Organization",
                "name": "Orion Contributors",
                "url": "https://github.com/Vimantha-Dilshan/developer-toolkit"
            },
            "publisher": {
                "@type": "Organization",
                "name": "Orion Contributors",
                "url": "https://github.com/Vimantha-Dilshan/developer-toolkit"
            },
            "offers": {
                "@type": "Offer",
                "price": "0",
                "priceCurrency": "USD"
            },
            "featureList": [
                "JSON Formatter and Validator",
                "SQL Formatter",
                "XML Formatter",
                "YAML Formatter",
                "UUID / ULID / NanoID Generator",
                "Password Generator",
                "Docker Compose Generator",
                "Lorem Ipsum Generator",
                "QR Code Generator",
                "Barcode Generator",
                "Regex Tester",
                "API Tester",
                "Diff Checker",
                "Cron Expression Parser",
                "Markdown Preview",
                "cURL Converter",
                "CSV to JSON Converter",
                "Timestamp Converter",
                "JWT Decoder",
                "ENV Comparator",
                "JSON Compare",
                "Hash Generator",
                "Base64 Encoder / Decoder",
                "URL Encoder / Decoder",
                "HTML Encoder / Decoder",
                "Color Picker",
                "AI Commit Generator",
                "OpenAPI Viewer",
                "Offline support via Service Worker",
                "Progressive Web App (PWA)",
                "Command palette with keyboard shortcuts",
                "Dark and light theme"
            ],
            "screenshot": "https://vimantha-dilshan.github.io/developer-toolkit/assets/images/og-image.png",
            "sameAs": [
                "https://github.com/Vimantha-Dilshan/developer-toolkit"
            ]
        },
